# Generated by setup.sh. Linux Docker Engine is required (applications use host networking).
COMPOSE_PROJECT_NAME=mtv2
COMPOSE_PROFILES=mongo,redis,es
API_IMAGE=ghcr.io/neiro-o/mtv2-api:latest
WEB_IMAGE=ghcr.io/neiro-o/mtv2-web:latest
MONGO_IMAGE=mongo:8.2.2
REDIS_IMAGE=redis:7.4.2-bookworm
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.11.4
GATEWAY_IMAGE=nginx:1.28-alpine
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=80
API_PORT=18080
WEB_PORT=13000
MONGO_PORT=27017
REDIS_PORT=6379
ES_PORT=9200
ES_HEAP=512m
MONGO_ROOT_PASSWORD=SET_BY_SETUP
REDIS_PASSWORD=SET_BY_SETUP
ELASTIC_PASSWORD=SET_BY_SETUP
MTV2_JWT_SECRET=SET_BY_SETUP
MTV2_MONGODB_URI=mongodb://mtv2_root:SET_BY_SETUP@127.0.0.1:27017/?authSource=admin
MTV2_REDIS_HOST=127.0.0.1
MTV2_REDIS_PORT=6379
MTV2_REDIS_PASSWORD=SET_BY_SETUP
MTV2_ES_HOSTS=http://127.0.0.1:9200
MTV2_ES_USERNAME=elastic
MTV2_ES_PASSWORD=SET_BY_SETUP
